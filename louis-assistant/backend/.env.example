# ============================================================
# 루이스(Louis) 개인비서 - 환경변수 설정 예시
# 이 파일을 .env로 복사하고 실제 값으로 채워주세요
# cp .env.example .env
# ============================================================

# -------------------------------------------------------
# [필수] Anthropic Claude API
# 발급: https://console.anthropic.com
# -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxx

# -------------------------------------------------------
# [필수] Google OAuth - 캘린더, Gmail, Drive
# 발급: https://console.cloud.google.com
# -------------------------------------------------------
GOOGLE_CLIENT_SECRET_FILE=./credentials.json

# -------------------------------------------------------
# [권장] 기상청 단기예보 API - 한국 정밀 날씨 (무료)
# 1. https://www.data.go.kr 회원가입
# 2. "기상청_단기예보 조회서비스" 검색 → 활용신청
# 3. 마이페이지 → 일반 인증키(디코딩) 복사
# 미입력 시 Open-Meteo(무료, 키 불필요)로 자동 전환
# -------------------------------------------------------
KMA_SERVICE_KEY=

# -------------------------------------------------------
# [선택] Serper.dev - 웹 검색
# 발급: https://serper.dev
# -------------------------------------------------------
SERPER_API_KEY=xxxxx

# -------------------------------------------------------
# [선택] DeepL - 번역
# 발급: https://www.deepl.com/pro-api
# -------------------------------------------------------
DEEPL_API_KEY=xxxxx:fx

# -------------------------------------------------------
# [선택] ElevenLabs - 고품질 TTS
# 발급: https://elevenlabs.io
# -------------------------------------------------------
ELEVENLABS_API_KEY=xxxxx

# -------------------------------------------------------
# [선택] Twilio - SMS/전화 (선택)
# 발급: https://www.twilio.com
# -------------------------------------------------------
TWILIO_ACCOUNT_SID=xxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_FROM_NUMBER=+18xxx

# -------------------------------------------------------
# [선택] Spotify - 음악 재생
# 발급: https://developer.spotify.com/dashboard
# -------------------------------------------------------
SPOTIFY_CLIENT_ID=xxxxx
SPOTIFY_CLIENT_SECRET=xxxxx

# -------------------------------------------------------
# [선택] Google Maps - 길찾기
# 발급: Google Cloud Console > Maps Directions API
# -------------------------------------------------------
GOOGLE_MAPS_API_KEY=xxxxx

# -------------------------------------------------------
# [선택] Phase 12: 교통 — SRT/KTX 예매
# SRT: https://etk.srail.kr
# 코레일: https://www.letskorail.com
# -------------------------------------------------------
SRT_ID=
SRT_PW=
KORAIL_ID=
KORAIL_PW=

# -------------------------------------------------------
# [선택] Phase 12: 서울 지하철 실시간 도착
# 발급: https://data.seoul.go.kr (무료 회원가입 필요)
# 앱 이름: LOUIS_APP → API 신청 → 서울 지하철 실시간 도착정보
# -------------------------------------------------------
SEOUL_API_KEY=

# -------------------------------------------------------
# [선택] Phase 12: 네이버 쇼핑 검색
# 발급: https://developers.naver.com → 애플리케이션 등록 → Shopping
# -------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# -------------------------------------------------------
# [선택] Phase 12: 카카오 주소/지도 API
# 발급: https://developers.kakao.com → 내 애플리케이션
# -------------------------------------------------------
KAKAO_API_KEY=

# -------------------------------------------------------
# [선택] Phase 12: 도로명주소 개발자센터 API (행정안전부)
# 발급: https://www.juso.go.kr/addrlink/devAddrLinkRequestWrite.do
# 카카오 API 키가 없을 때 우편번호 검색 폴백으로 사용
# -------------------------------------------------------
JUSO_API_KEY=

# -------------------------------------------------------
# 앱 설정
# -------------------------------------------------------
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-string
APP_PORT=8000
APP_HOST=0.0.0.0

# JWT 설정 (초 단위)
JWT_ACCESS_TOKEN_EXPIRE=900      # 15분
JWT_REFRESH_TOKEN_EXPIRE=2592000 # 30일

# LLM 설정
LLM_DEFAULT_MODEL=claude-haiku-4-5-20251001
LLM_COMPLEX_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500

# 비용 관리
DAILY_TOKEN_LIMIT=100000         # 유저 1인 일일 토큰 한도
MONTHLY_BUDGET_USD=10.0          # 월간 예산 한도

# DB
DATABASE_URL=sqlite+aiosqlite:///./louis.db

# Redis (캐싱, 선택)
REDIS_URL=redis://localhost:6379/0

# 로컬 DB
LOCAL_DB_PATH=./louis.db

# 타임존
TIMEZONE=Asia/Seoul

# 로그 레벨
LOG_LEVEL=INFO
